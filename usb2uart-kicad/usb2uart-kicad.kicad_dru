(version 1)

# JLCPCB four-layer FR-4, JLC04161H-7628, 1 oz outer / 0.5 oz inner.
# https://jlcpcb.com/capabilities/pcb-capabilities
# General via/NPTH clearances remain the conservative board defaults.
# Component drills need stricter spacing than vias.
(rule "JLCPCB component pad hole spacing"
    (condition "A.Type == 'Pad' && B.Type == 'Pad'")
    (constraint hole_to_hole (min 0.45mm)))

(rule "JLCPCB PTH hole to other-net copper"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint hole_clearance (min 0.28mm)))

(rule "JLCPCB inner PTH hole to other-net copper"
    (layer inner)
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
    (constraint hole_clearance (min 0.30mm)))

# USB netclass and differential routing preset: W=0.255mm, S=0.16mm.
# Nominal 90-ohm differential target, F.Cu over solid In1.Cu GND.
# JLCPCB calculator: 0.2545mm width at 0.16mm gap, covered non-coplanar
# differential microstrip, nominal 1.6mm, 1 oz outer / 0.5 oz inner.
# Nearby same-layer ground copper requires a coplanar recalculation.
